{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stokku",
  "version": "0.1.0",
  "identifier": "id.stokku.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "pnpm --filter @stokku/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Stokku — Inventaris UMKM",
        "width": 1000,
        "height": 720,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
