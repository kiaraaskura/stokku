# Stokku environment template. Copy to .env and fill in.
# .env is gitignored — NEVER commit real secrets.
# On the shared dev machine, a ready-made local env exists OUTSIDE the repo:
#   /home/kiara/OpenBot/Shared/dev/stokku.env

# Postgres connection string used by the API, migrations, seed and backups.
# Local dev shape: postgres://stokku:<password>@127.0.0.1:55442/stokku
# Must be a NON-superuser role (forced RLS binds only non-superusers).
DATABASE_URL=postgres://stokku:CHANGE_ME@127.0.0.1:55442/stokku

# HMAC secret for signing JWT access tokens. Generate one:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Public base URL of the deployment, no trailing slash (CORS + share links).
APP_BASE_URL=http://127.0.0.1:8080

# Optional overrides
# PORT=8080
# RUST_LOG=info
# Password for the docker-compose postgres (used by `make up`)
# POSTGRES_PASSWORD=CHANGE_ME
