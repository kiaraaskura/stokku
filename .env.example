# Stokku environment template. Copy to .env and fill in.
# .env is gitignored — NEVER commit real secrets.
# On the shared dev machine, a ready-made local env exists OUTSIDE the repo:
#   /home/kiara/OpenBot/Shared/dev/stokku.env

# Postgres connection string used by the API, seed and backups.
# Local dev shape: postgres://stokku:<password>@127.0.0.1:55442/stokku
# Must be a NON-superuser role (forced RLS binds only non-superusers).
# Migrations prefer MIGRATION_DATABASE_URL below when set.
DATABASE_URL=postgres://stokku:CHANGE_ME@127.0.0.1:55442/stokku

# MIGRATION_DATABASE_URL — optional admin (superuser) DSN used only by scripts/migrate.sh to run migrations; it must never be the API's runtime DSN.
#MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:55442/postgres
# STOKKU_TEST_ADMIN_URL — optional admin DSN for the DB-backed cargo tests (scratch DB, migrate as superuser, connect as the non-superuser role stokku); it must never be the API's runtime DSN.
#STOKKU_TEST_ADMIN_URL=postgres://postgres@127.0.0.1:55442/postgres

# HMAC secret for signing JWT access tokens. Generate one:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Public base URL of the deployment, no trailing slash (CORS + share links).
APP_BASE_URL=http://127.0.0.1:8080

# Optional overrides
# PORT=8080
# RUST_LOG=info
# Compose stack (make up):
# POSTGRES_PASSWORD=CHANGE_ME        # compose postgres superuser
# STOKKU_DB_PASSWORD=CHANGE_ME       # non-superuser app role the API uses
